{
  "entities": {
    "QRMapping": {
      "title": "QR Mapping",
      "description": "Maps a unique short ID to a destination URL.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique short ID" },
        "destinationUrl": { "type": "string", "description": "The target URL" },
        "createdAt": { "type": "string", "format": "date-time" },
        "qrStyle": { 
          "type": "object", 
          "properties": {
            "fgColor": { "type": "string" },
            "bgColor": { "type": "string" }
          }
        },
        "pageConfig": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "message": { "type": "string" },
            "theme": { "type": "string" }
          }
        }
      },
      "required": ["id", "destinationUrl", "createdAt"]
    }
  },
  "firestore": {
    "/qr_mappings/{qrId}": {
      "schema": "QRMapping",
      "description": "Collection of QR code redirect mappings."
    }
  }
}
